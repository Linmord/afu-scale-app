{
  "expo": {
    "name": "AFU",
    "slug": "afu-scale",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "INTERNET"
      ],
      "package": "com.aiyue.afuscale"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aiyue.afuscale"
    },
    "plugins": [
      "react-native-ble-plx",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-localization",
      "./plugins/removeNeverForLocation.js"
    ],
    "newArchEnabled": true
  }
}
